{
  "openapi": "3.0.0",
  "info": {
    "title": "PrimeFlex API",
    "version": "1.0.0",
    "description": "API documentation for PrimeFlex backend",
    "contact": {
      "name": "admin",
      "email": "admin@example.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:10032",
      "description": "Development server"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "summary": "Register a new user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRegistration"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User successfully registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Log in a user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserLogin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User logged in successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid login credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/films": {
      "get": {
        "summary": "Get all films",
        "responses": {
          "200": {
            "description": "List of films",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Film"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new film",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewFilm"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Film created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Film"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ratings": {
      "get": {
        "summary": "Get all ratings",
        "responses": {
          "200": {
            "description": "List of ratings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserRating"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "summary": "Search for films, series, and trends",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Search query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Film"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/trends": {
      "get": {
        "summary": "Get all trends",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "example": [
                  {
                    "title": "Trend 1",
                    "description": "Description of Trend 1",
                    "image": "trend1.jpg",
                    "releaseYear": 2024,
                    "duration": 120,
                    "genre": ["Action", "Adventure"],
                    "director": "Director 1",
                    "actors": ["Actor 1", "Actor 2"],
                    "thumbnail": "trend1-thumbnail.jpg",
                    "rating": "PG-13",
                    "imdbid": "tt1234567",
                    "imdb_link": "https://www.imdb.com/title/tt1234567/"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/user-ratings/{filmId}": {
      "get": {
        "summary": "Get ratings for a film",
        "parameters": [
          {
            "name": "filmId",
            "in": "path",
            "required": true,
            "description": "ID of the film",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "example": [
                  {
                    "user": "user1",
                    "film": "film1",
                    "rating": 4,
                    "review": "Great movie!",
                    "createdAt": "2024-06-11T12:00:00.000Z"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/api/user-ratings": {
      "post": {
        "summary": "Add a rating for a film",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRating"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Rating added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRating"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserRegistration": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 6
          }
        },
        "required": ["username", "email", "password"]
      },
      "UserLogin": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["email", "password"]
      },
      "NewFilm": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "genre": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "releaseYear": {
            "type": "number"
          },
          "director": {
            "type": "string"
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration": {
            "type": "number"
          },
          "image": {
            "type": "string"
          },
          "big_image": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string"
          },
          "rating": {
            "type": "string"
          },
          "imdbid": {
            "type": "string"
          },
          "imdb_link": {
            "type": "string"
          }
        },
        "required": ["title", "description", "genre", "releaseYear", "director", "actors", "duration", "image", "big_image", "thumbnail", "rating", "imdbid", "imdb_link"]
      },
      "UserRating": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string"
          },
          "film": {
            "type": "string"
          },
          "rating": {
            "type": "number"
          },
          "review": {
            "type": "string"
          }
        },
        "required": ["user", "film", "rating"]
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "token": {
            "type": "string"
          }
        }
      },
      "Film": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "genre": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "releaseYear": {
            "type": "number"
          },
          "director": {
            "type": "string"
          },
          "actors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "duration": {
            "type": "number"
          },
          "image": {
            "type": "string"
          },
          "big_image": {
            "type": "string"
          },
          "thumbnail": {
            "type": "string"
          },
          "rating": {
            "type": "string"
          },
          "imdbid": {
            "type": "string"
          },
          "imdb_link": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}